PKG="dev.burixon.mockgps"
SERVICE=".MockLocationService"
RECEIVER=".MockGpsReceiver"
SILENT='no'
VERSION="1.0.0"

usage() {
	cat <<EOF
usage: termux-mockgps <command> [options]

Mock device's GPS location via MockGPS.

Commands:
  start [lat lon]       Start mocking a location.
  set <lat lon>         Set the mock location.
  stop                  Stop mocking and restore normal location.
  help                  Show this help message.
  version               Show version information.

Location:
  Coordinates can be specified as:
    50.06143 19.93658
    50.06143,19.93658
    -lat:50.06143 -lon:19.93658

Options:
  -silent               Suppress location change notifications.

Examples:
  termux-mockgps start
  termux-mockgps start 50.06143 19.93658
  termux-mockgps set 50.06143,19.93658
  termux-mockgps set -lat:50.06143 -lon:19.93658 -silent
  termux-mockgps stop
EOF
}

is_installed() {
	pm path "$PKG" >/dev/null 2>&1
}

valid_number() {
	case "$1" in
		''|'-'|'+'|'.'|'-.'|'+.')
			return 1
			;;

		*[!0-9.+-]*)
			return 1
			;;
	esac

	return 0
}

command_start() {

	if ! is_installed; then
		printf '%s\n' "MockGPS is not installed." >&2
		printf '%s\n' "Visit https://burixon.dev/MockGPS/ to learn more." >&2
		return 1
	fi

	lat="$1"
	lon="$2"

	if [ -n "$lat" ] || [ -n "$lon" ]; then

		if [ -z "$lat" ] || [ -z "$lon" ]; then
			printf '%s\n' "Invalid coordinates." >&2
			return 1
		fi

		if ! valid_number "$lat" ||
			! valid_number "$lon"
		then
			printf '%s\n' "Invalid coordinates." >&2
			return 1
		fi

		printf '%s\n' "Starting service:"
		"$AM" startservice \
			-n "$PKG/$SERVICE" \
			--es command on \
			--es lat "$lat" \
			--es lon "$lon"
	else
		printf '%s\n' "Starting service:"
		"$AM" startservice \
			-n "$PKG/$SERVICE" \
			--es command on
	fi
}

command_set() {

	if ! is_installed; then
		printf '%s\n' "MockGPS is not installed." >&2
		printf '%s\n' "Visit https://burixon.dev/MockGPS/ to learn more." >&2
		return 1
	fi

	lat="$1"
	lon="$2"

	if [ -z "$lat" ] || [ -z "$lon" ]; then
		printf '%s\n' "Invalid coordinates." >&2
		return 1
	fi

	if ! valid_number "$lat" ||
		! valid_number "$lon"
	then
		printf '%s\n' "Invalid coordinates." >&2
		return 1
	fi

	printf '%s\n' "Setting new coordinates:"
	"$AM" broadcast \
		-n "$PKG/$RECEIVER" \
		--es command set \
		--es lat "$lat" \
		--es lon "$lon" \
		--es silent "$SILENT"
}

command_stop() {

	status=0

	if ! is_installed; then
		printf '%s\n' "MockGPS is not installed." >&2
		printf '%s\n' "Visit https://burixon.dev/MockGPS/ to learn more." >&2
		return 1
	fi

	printf '%s\n' "Stopping service:"
	"$AM" stopservice \
		-n "$PKG/$SERVICE"
	status=$((status+$?))

	printf '%s\n' "Disabling service:"
	"$AM" broadcast \
		-n "$PKG/$RECEIVER" \
		--es command off \
		--es source cmd
	status=$((status+$?))

	return $status
}

COMMAND=""
LAT=""
LON=""

until [ "$#" -eq 0 ]; do

	case "$1" in

		start|stop|set|help|-h|--help)
			if [ -z "$COMMAND" ]; then
				COMMAND="$1"
			fi
			shift
			;;

		-lat:*)
			LAT=${1#-lat:}
			shift
			;;

		-lon:*)
			LON=${1#-lon:}
			shift
			;;

		-silent)
			SILENT='yes'
			shift
			;;

		version|--version|-v)
			printf '%s %s\n' termux-mockgps "$VERSION"
			exit 0
			;;
		-*)
			printf '%s\n' "Unknown option: $1" >&2
			usage >&2
			exit 1
			;;

		*)
			case "$1" in
				*,*)
					if [ -z "$LAT" ] && [ -z "$LON" ]; then
						LAT=${1%%,*}
						LON=${1#*,}
					else
						printf '%s\n' "Too many arguments." >&2
						exit 1
					fi
					;;

				*)
					if [ -z "$LAT" ]; then
						LAT="$1"
					elif [ -z "$LON" ]; then
						LON="$1"
					else
						printf '%s\n' "Too many arguments." >&2
						exit 1
					fi
					;;
			esac

			shift
			;;

	esac

done

if [ -x "$(command -v am 2>/dev/null)" ]; then
	AM="$(command -v am)"
elif [ -x /system/bin/am ]; then
	AM="/system/bin/am"
else
	printf '%s\n' "Android 'am' command not found." >&2
	exit 1
fi

case "$COMMAND" in

	start)
		command_start "$LAT" "$LON"
		;;

	set)
		command_set "$LAT" "$LON"
		;;

	stop)
		command_stop
		;;

	help|-h|--help)
		usage
		;;
	"")
		usage >&2
		exit 1
		;;
	*)
		printf '%s\n' "Unknown command: $COMMAND" >&2
		usage >&2
		exit 1
		;;

esac
