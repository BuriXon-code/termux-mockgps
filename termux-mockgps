# important variables ans states
PKG="dev.burixon.mockgps"
SERVICE=".MockLocationService"
RECEIVER=".MockGpsReceiver"
URL="https://burixon.dev/MockGPS/"
TOAST="yes"
VERSION="1.0.0"

# usage info
usage() {
	cat <<EOF
termux-mockgps (c) 2026 Kamil BuriXon Burek
Mock device's GPS location via MockGPS app.

usage: termux-mockgps <command> [options]

Commands:
  start [lat lon]       Start mocking a location.
  set <lat lon>         Set the mock location.
  boot <0|1|on|off>     Enable or disable mocking on device boot.
  open                  Open MockGPS application.
  stop                  Stop mocking and restore normal location.
  help                  Show this help message.
  version               Show version information.

Location:
  Coordinates can be specified as:
    50.06143 19.93658
    50.06143,19.93658
    -lat:50.06143 -lon:19.93658

Boot:
  Values:
    1|on                Enable mocking on boot.
    0|off               Disable mocking on boot.

Options:
  -notoast              Do not display toast notification.

Examples:
  termux-mockgps start
  termux-mockgps start 50.06143 19.93658
  termux-mockgps start -50.06143 -19.93658
  termux-mockgps set 50.06143,19.93658
  termux-mockgps set -50.06143,-19.93658
  termux-mockgps set -lat:50.06143 -lon:-19.93658 -notoast
  termux-mockgps boot 1
  termux-mockgps boot on -notoast
  termux-mockgps boot 0
  termux-mockgps boot off
  termux-mockgps open
  termux-mockgps stop
EOF
}

# checking if the package is installed
is_installed() {
	PM=""
	
	# we use android system pm because pm in Termux
	# is broken by default and I don't want to require
	# the user to fix it themselves...
	#
	#  I wonder when the termux or termux package
	# developers will look into this and fix this...
	# it's crap - just remove two lines...
	
	for path in \
	    /system/bin/pm \
	    /system/xbin/pm \
	    /vendor/bin/pm \
	    /product/bin/pm \
	    /apex/*/bin/pm
	do
		# we check each of the files mentioned above
		# and the first one available becomes our
		# executable file
	    if [ -n "$path" ] && [ -x "$path" ]; then
	        PM="$path"
	        break
	    fi
	done
	
	if [ -z "$PM" ]; then
	    printf "%s\n" "Error: pm command not found." >&2
	    exit 1
	fi
		
	if ! "$PM" path "$PKG" >/dev/null 2>&1; then
		printf '%s\n' "MockGPS app is not installed." >&2
		printf '%s\n' "For more information, visit ${URL}." >&2
		exit 1
	fi
}

valid_coordinate() {

	# yes yes... this whole function can be enclosed
	# in 2-4 lines of AWK...
	#
	# but I don't use AWK on purpose - I rely on POSIX sh

	# so here a thorough check takes place whether the
	# given parameters are the correct coordinates meeting
	# the standards of the script and then the broadcast
	# receiver parser

	value="$1"
	max="$2"

	case "$value" in
		''|'+'|'-'|'.'|'+.'|-.*.*|+.*.*|*.*.*|*[!0-9.+-]*)
			return 1
			;;
	esac

	case "$value" in
		+*|-*)
			number=${value#?}
			;;
		*)
			number="$value"
			;;
	esac

	case "$number" in
		*+*|*-*)
			return 1
			;;
	esac

	integer=${number%%.*}

	case "$number" in
		*.*)
			fraction=${number#*.}
			;;
		*)
			fraction=""
			;;
	esac

	if [ -z "$integer" ]; then
		integer=0
	fi

	case "$integer" in
		*[!0-9]*)
			return 1
			;;
	esac

	case "$fraction" in
		*[!0-9]*)
			return 1
			;;
	esac

	while [ "${integer#0}" != "$integer" ] && [ "$integer" != "0" ]; do
		integer=${integer#0}
	done

	if [ "$integer" -gt "$max" ] 2>/dev/null; then
		return 1
	fi

	if [ "$integer" -eq "$max" ] 2>/dev/null; then
		case "$fraction" in
			''|0*)
				;;
			*)
				return 1
				;;
		esac
	fi

	return 0
}

command_start() {

	# this function passes parameters (coordinates) to the
	# parser and then executes am with or without
	# parameters accordingly

	is_installed

	lat="$1"
	lon="$2"

	if [ -n "$lat" ] || [ -n "$lon" ]; then

		if [ -z "$lat" ] || [ -z "$lon" ]; then
			printf '%s\n' "Invalid coordinates." >&2
			return 1
		fi

		if ! valid_coordinate "$lat" 90 ||
			! valid_coordinate "$lon" 180
		then
			printf '%s\n' "Invalid coordinates." >&2
			return 1
		fi

		printf '%s' "Starting service: "
		if "$AM" startservice \
			-n "$PKG/$SERVICE" \
			--es command on \
			--es toast "$TOAST" \
			--es lat "$lat" \
			--es lon "$lon" >/dev/null 2>&1; then
			printf '%b\n' "\033[1;32mok\033[0m"
		else
			printf '%b\n' "\a\033[1;31merror\033[0m" >&2
			exit 1
		fi
	else
		printf '%s' "Starting service: "
		if "$AM" startservice \
			-n "$PKG/$SERVICE" \
			--es command on \
			--es toast "$TOAST" >/dev/null 2>&1; then
			printf '%b\n' "\033[1;32mok\033[0m"
		else
			printf '%b\n' "\a\033[1;31merror\033[0m" >&2
			exit 1
		fi
	fi
}

command_set() {

	# similarly, but with the set command

	is_installed

	lat="$1"
	lon="$2"

	if [ -z "$lat" ] || [ -z "$lon" ]; then
		printf '%s\n' "Invalid coordinates." >&2
		return 1
	fi

	if ! valid_coordinate "$lat" 90 ||
		! valid_coordinate "$lon" 180
	then
		printf '%s\n' "Invalid coordinates." >&2
		return 1
	fi

	printf '%s' "Setting new coordinates: "
	if "$AM" broadcast \
		-n "$PKG/$RECEIVER" \
		--es command set \
		--es toast "$TOAST" \
		--es lat "$lat" \
		--es lon "$lon" >/dev/null 2>&1; then
		printf '%b\n' "\033[1;32mok\033[0m"
	else
		printf '%b\n' "\a\033[1;31merror\033[0m" >&2
		exit 1
	fi
}

command_boot() {

	# and again - analogously

	is_installed

	boot="$1"

	case "$boot" in
		1|on|enable|true)
			boot_action="enable"
			;;

		0|off|disable|false)
			boot_action="disable"
			;;

		*)
			printf '%s\n' "Invalid boot option. Use 0, 1, on or off." >&2
			return 1
			;;
	esac

	printf '%s' "Setting boot mode: "
	if "$AM" broadcast \
		-n "$PKG/$RECEIVER" \
		--es conmand boot \
		--es boot "$boot_action" \
		--es toast "$TOAST" >/dev/null 2>&1; then
		printf '%b\n' "\033[1;32mok\033[0m"
	else
		printf '%b\n' "\a\033[1;31merror\033[0m" >&2
		exit 1
	fi
}
command_drift() {

	# and again :)

	is_installed

	drift="$1"

	case "$drift" in
		1|on|enable|true)
			drift_action="enable"
			;;

		0|off|disable|false)
			drift_action="disable"
			;;

		*)
			printf '%s\n' "Invalid drift option. Use 0, 1, on or off." >&2
			return 1
			;;
	esac

	printf '%s' "Setting drift mode: "
	if "$AM" broadcast \
		-n "$PKG/$RECEIVER" \
		--es command drift \
		--es toast "$TOAST" \
		--es drifting "$drift_action"  >/dev/null 2>&1; then
		printf '%b\n' "\033[1;32mok\033[0m"
	else
		printf '%b\n' "\a\033[1;31merror\033[0m" >&2
		exit 1
	fi
}

command_open() {

	# oh, this is probably the simplest function

	# I don't know if it will be useful to anyone, but
	# let it be

	is_installed

	printf '%s' "Opening MockGPS: "
	if "$AM" start \
		-n "$PKG/.MainActivity" >/dev/null 2>&1; then
		printf '%b\n' "\033[1;32mok\033[0m"
	else
		printf '%b\n' "\a\033[1;31merror\033[0m" >&2
		exit 1
	fi
}

command_stop() {

	# and again letters and symbols...

	status=0

	is_installed

	printf '%s' "Stopping service: "
	if "$AM" stopservice \
		-n "$PKG/$SERVICE" >/dev/null 2>&1; then
		printf '%b\n' "\033[1;32mok\033[0m"
	else
		status=$((status+$?))
		printf '%b\n' "\a\033[1;33mnot running\033[0m" >&2
	fi

	printf '%s' "Requesting service disable: "
	if "$AM" broadcast \
		-n "$PKG/$RECEIVER" \
		--es command off \
		--es toast "$TOAST" \
		--es source cmd >/dev/null 2>&1; then
		printf '%b\n' "\033[1;32mok\033[0m"
	else
		status=$((status+$?))
		printf '%b\n' "\a\033[1;31merror\033[0m" >&2
	fi

	exit $status
}

# and this is where, dear reader, the main logic begins
# - accepting and parsing arguments, and then choosing
# the appropriate path further :)

COMMAND=""
LAT=""
LON=""
BOOT=""

until [ "$#" -eq 0 ]; do

	case "$1" in

		start|stop|set|boot|drift|open|help|-h|--help)
			if [ -z "$COMMAND" ]; then
				COMMAND="$1"
			fi
			shift
			;;

		-lat:*)
			LAT=${1#-lat:}
			shift
			;;

		-lon:*)
			LON=${1#-lon:}
			shift
			;;

		-notoast)
			TOAST="no"
			shift
			;;

		version|--version|-v)
			printf '%s %s\n' termux-mockgps "$VERSION"
			exit 0
			;;

		*,*)
			if [ -z "$LAT" ] && [ -z "$LON" ]; then
				LAT=${1%%,*}
				LON=${1#*,}
			else
				printf '%s\n' "Too many arguments." >&2
				exit 1
			fi

			shift
			;;

		-[0-9]*|-.[0-9]*)
			if [ -z "$LAT" ]; then
				LAT="$1"
			elif [ -z "$LON" ]; then
				LON="$1"
			else
				printf '%s\n' "Too many arguments." >&2
				exit 1
			fi

			shift
			;;

		-*)
			printf '%s\n' "Unknown option: $1" >&2
			usage >&2
			exit 1
			;;

		*)
			if [ "$COMMAND" = "boot" ] && [ -z "$BOOT" ]; then
				case "$1" in
					0|1|on|off|true|false|enable|disable)
						BOOT="$1"
						shift
						continue
						;;

					*)
						printf '%s\n' "Invalid boot option: $1" >&2
						exit 1
						;;
				esac
			fi
			if [ "$COMMAND" = "drift" ] && [ -z "$DRIFT" ]; then
				case "$1" in
					0|1|on|off|true|false|enable|disable)
						DRIFT="$1"
						shift
						continue
						;;

					*)
						printf '%s\n' "Invalid drift option: $1" >&2
						exit 1
						;;
				esac
			fi

			case "$1" in
				*,*)
					if [ -z "$LAT" ] && [ -z "$LON" ]; then
						LAT=${1%%,*}
						LON=${1#*,}
					else
						printf '%s\n' "Too many arguments." >&2
						exit 1
					fi
					;;

				*)
					if [ -z "$LAT" ]; then
						LAT="$1"
					elif [ -z "$LON" ]; then
						LON="$1"
					else
						printf '%s\n' "Too many arguments." >&2
						exit 1
					fi
					;;
			esac

			shift
			;;

	esac

done

if [ -x "$(command -v am 2>/dev/null)" ]; then
	AM="$(command -v am)"
elif [ -x /system/bin/am ]; then
	AM="/system/bin/am"
else
	printf '%s\n' "Android 'am' command not found." >&2
	exit 1
fi

case "$COMMAND" in

	start)
		command_start "$LAT" "$LON"
		;;

	set)
		command_set "$LAT" "$LON"
		;;

	boot)
		command_boot "$BOOT"
		;;
		
	drift)
		command_drift "$DRIFT"
		;;

	open)
		command_open
		;;

	stop)
		command_stop
		;;

	help|-h|--help)
		usage
		;;

	"")
		usage >&2
		exit 1
		;;

	*)
		printf '%s\n' "Unknown command: $COMMAND" >&2
		usage >&2
		exit 1
		;;

esac

# and that's it :)
